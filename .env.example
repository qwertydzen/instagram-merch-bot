# --- Arcade (merch engine) ------------------------------------------------
# Create a key: Arcade Studio -> Settings -> API keys
ARCADE_API_KEY=
ARCADE_BASE_URL=https://platform.arcade.ai/v1
# Arcade rejects requests with a default/blank User-Agent. Name your app + contact.
ARCADE_USER_AGENT=instagram-merch-bot/1.0 (you@example.com)

# --- Instagram (Meta Graph API) -------------------------------------------
# IG Business/Creator account linked to a Facebook Page + a Meta app are required.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_VERIFY_TOKEN=change-me-verify-token
IG_APP_SECRET=
GRAPH_BASE_URL=https://graph.instagram.com
GRAPH_API_VERSION=v23.0

# --- Runtime ---------------------------------------------------------------
# Force mock mode even if credentials exist. Auto-on when ARCADE_API_KEY is blank.
MOCK_MODE=
JOB_POLL_INTERVAL=3
JOB_TIMEOUT=180

# --- Cache (read-only catalogue data) --------------------------------------
# Categories, styles and option trees are cached in memory + on disk so the
# app opens instantly and spends no API calls. Work-creating calls are never cached.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=43200
CACHE_DIR=
WARM_CACHE_ON_START=true
# Instagram post URL -> Arcade referenceId (default 30 days)
POST_CACHE_TTL_SECONDS=2592000
